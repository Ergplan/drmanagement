# Cloud (Vercel) – Neon vars are added by the Vercel Marketplace integration
DATABASE_URL=
AUTH_SECRET=
DEMO_PASSWORD=
RESEND_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Edge (VM)
CLOUD_URL=https://globe.joulewise.tech
DEVICE_ID=edge-globe-lko-01
DEVICE_SECRET=
SIM_SPEED=1
SIM_SCENARIO=normal
SIM_SEED=42
# false = duty engineer not reachable: the engineer-armed interlock blocks every command
ENGINEER_ARMED=true
EDGE_INTENTS_MS=5000
# Builder tooling (VM only)
OPENAI_API_KEY=
REVIEW_MODEL=
# Edge <-> cloud signing (same values in Vercel: EDGE_DEVICE_ID, EDGE_DEVICE_SECRET)
EDGE_DEVICE_ID=edge-globe-lko-01
EDGE_DEVICE_SECRET=
# Reports (Stage 5)
CRON_SECRET=
PUBLIC_URL=https://globe.joulewise.tech
# 1 = store report PDFs in Vercel Blob (public, unguessable URL); default keeps them in the VM database
REPORTS_IN_BLOB=0
# Edge renderer: docker-compose sets PDF_WS_ENDPOINT=ws://pdf:3000/; outside Docker point PDF_CHROME_PATH at Chrome
PDF_WS_ENDPOINT=
PDF_CHROME_PATH=
EDGE_REPORTS_MS=30000
# Ask ergOS (Stage 7): read-only assistant; ASSISTANT_API_KEY is already listed above
ASSISTANT_MODEL=claude-sonnet-5-5
# OpenADR 3.0 VEN (feature flag: leave the URL empty to switch it off). Test VTN: pnpm --filter @drm/grid test-vtn
OPENADR_VTN_URL=
OPENADR_CLIENT_ID=
OPENADR_CLIENT_SECRET=
OPENADR_VEN_NAME=globe-lko
OPENADR_PROGRAMS=
EDGE_HOUSEKEEPING_MS=300000
